<h1 class="text-lg font-semibold text-slate-900">マイページ</h1>

<div
  class="sunset-panel mt-4 overflow-hidden rounded-lg p-4 shadow"
  <% if @sunset_info %>
    data-controller="sunset-theme"
    data-sunset-theme-sunset-at-value="<%= @sunset_info.sunset_at.iso8601 %>"
    data-sunset-theme-dusk-at-value="<%= @sunset_info.dusk_at.iso8601 %>"
  <% end %>
>
  <p class="text-sm text-slate-500">現在のランク</p>
  <p class="text-2xl font-bold text-slate-900"><%= @rank&.name || "ランクなし" %></p>
  <% if @rank&.benefit_description.present? %>
    <p class="mt-1 text-sm text-slate-600"><%= @rank.benefit_description %></p>
  <% end %>

  <div class="mt-4 flex items-center gap-2">
    <div class="flex flex-wrap gap-1">
      <% [@stamps.size, 10].min.times do %>
        <span class="flex h-6 w-6 items-center justify-center overflow-hidden rounded-full border border-amber-400">
          <%= image_tag "stamp-badge.png", class: "h-full w-full object-cover", alt: "" %>
        </span>
      <% end %>
      <% if @stamps.size > 10 %>
        <span class="flex h-6 items-center px-1 text-xs font-semibold text-amber-700">+<%= @stamps.size - 10 %></span>
      <% end %>
    </div>
  </div>
  <p class="mt-2 text-sm text-slate-500">スタンプ数: <%= @stamps.size %></p>

  <% if @next_rank %>
    <p class="mt-1 text-xs text-amber-700">
      次のランク「<%= @next_rank.name %>」まであと<%= @next_rank.min_stamps - @stamps.size %>個
    </p>
  <% end %>
</div>

<h2 class="mt-6 text-sm font-semibold text-slate-700">来場履歴</h2>
<ul class="mt-2 divide-y divide-slate-200 rounded-lg bg-white shadow">
  <% @stamps.each do |stamp| %>
    <li class="flex items-center gap-2 px-4 py-3 text-sm text-slate-700">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center overflow-hidden rounded-full border border-amber-300">
        <%= image_tag "stamp-badge.png", class: "h-full w-full object-cover", alt: "" %>
      </span>
      <span><%= stamp.event.title %>(<%= stamp.event.held_on.strftime("%Y年%m月%d日") %>)</span>
    </li>
  <% end %>
  <% if @stamps.empty? %>
    <li class="px-4 py-3 text-sm text-slate-400">まだ来場記録がありません</li>
  <% end %>
</ul>
